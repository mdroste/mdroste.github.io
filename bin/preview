#!/usr/bin/env bash
set -euo pipefail

SITE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$SITE_ROOT"

# Prefer the project-local Ruby installed for this Mac.
if [[ -x "$SITE_ROOT/vendor/ruby/bin/ruby" ]]; then
  export PATH="$SITE_ROOT/vendor/ruby/bin:$PATH"
fi
export BUNDLE_GEMFILE="$SITE_ROOT/Gemfile"
export BUNDLE_PATH="$SITE_ROOT/vendor/bundle"
export JEKYLL_ENV=development

if ! bundle check; then
  echo 'Install the missing gems with: PATH="$PWD/vendor/ruby/bin:$PATH" bundle install' >&2
  exit 1
fi

exec bundle exec jekyll serve \
  --config _config.yml,_config.local.yml \
  --host 127.0.0.1 \
  --livereload \
  "$@"
